#include <nuttx/config.h>

#ifdef CONFIG_NET_WIREGUARD

/* Bring up the WireGuard tunnel using the keys and peer from Kconfig.
 *
 * nsh_init.c runs this script after netinit_bringup(), so the Wi-Fi link
 * is already starting. wg does not need an address on the underlying
 * interface to succeed: it binds INADDR_ANY and the handshake is retried
 * by wg_rx every REKEY_TIMEOUT until DHCP has finished. Without this the
 * tunnel would only ever come up by typing wg on a console, which is
 * exactly what is unavailable on a headless board.
 */

wg

#endif
