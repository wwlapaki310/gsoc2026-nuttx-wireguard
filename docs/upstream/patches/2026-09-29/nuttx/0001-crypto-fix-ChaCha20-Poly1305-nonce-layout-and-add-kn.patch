From a5d9148cf59034a65152e1812a173fcc17319172 Mon Sep 17 00:00:00 2001
From: satoru akita <wwlap24@gmail.com>
Date: Mon, 28 Sep 2026 23:42:56 +0900
Subject: [PATCH 1/2] crypto: fix ChaCha20-Poly1305 nonce layout and add
 known-answer tests

Place the 64-bit counter nonce in the last eight bytes of the IETF nonce. Carry the ChaCha20-Poly1305 and XChaCha20-Poly1305 vectors with this prerequisite, independently of the WireGuard driver.
---
 crypto/chachapoly.c |  18 ++++-
 crypto/testmngr.c   | 147 ++++++++++++++++++++++++++++++++++++++-
 crypto/testmngr.h   | 165 ++++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 327 insertions(+), 3 deletions(-)

diff --git a/crypto/chachapoly.c b/crypto/chachapoly.c
index 8a0c47a52c..c2f9bd3e62 100644
--- a/crypto/chachapoly.c
+++ b/crypto/chachapoly.c
@@ -195,8 +195,15 @@ void chacha20poly1305_encrypt(
 
   uint64_t le_nonce = htole64(nonce);
   uint8_t le_nonce_array[12];
+
   explicit_bzero(le_nonce_array, sizeof(le_nonce_array));
-  memcpy(le_nonce_array, &le_nonce, sizeof(uint64_t));
+
+  /* The 64-bit counter occupies the last 8 bytes of the 96-bit nonce, with
+   * the first 4 bytes left zero (RFC 8439 / WireGuard convention, matching
+   * wireguard-go's PutUint64(nonce[4:], counter)).
+   */
+
+  memcpy(le_nonce_array + 4, &le_nonce, sizeof(uint64_t));
 
   chacha_keysetup(&ctx, key, CHACHA20POLY1305_KEY_SIZE * 8);
   chacha_ivsetup(&ctx, le_nonce_array, NULL);
@@ -247,8 +254,15 @@ int chacha20poly1305_decrypt(
 
   uint64_t le_nonce = htole64(nonce);
   uint8_t le_nonce_array[12];
+
   explicit_bzero(le_nonce_array, sizeof(le_nonce_array));
-  memcpy(le_nonce_array, &le_nonce, sizeof(uint64_t));
+
+  /* The 64-bit counter occupies the last 8 bytes of the 96-bit nonce, with
+   * the first 4 bytes left zero (RFC 8439 / WireGuard convention, matching
+   * wireguard-go's PutUint64(nonce[4:], counter)).
+   */
+
+  memcpy(le_nonce_array + 4, &le_nonce, sizeof(uint64_t));
 
   if (src_len < CHACHA20POLY1305_AUTHTAG_SIZE)
     {
