+/* ChaCha20-Poly1305 / XChaCha20-Poly1305 AEAD test vectors.
+ * crypto/chachapoly.c is always compiled, so these are not guarded by an
+ * algorithm Kconfig option.
+ */
+
+struct aead_testvec
+{
+  FAR const char *key;             /* 32-byte key */
+  FAR const char *ad;              /* associated data */
+  FAR const char *input;           /* plaintext */
+  FAR const char *result;          /* ciphertext || 16-byte tag */
+  uint64_t counter;                /* 64-bit AEAD nonce counter */
+  unsigned short adlen;
+  unsigned short ilen;
+  unsigned short rlen;             /* ilen + 16 */
+};
+
+struct xaead_testvec
+{
+  FAR const char *key;             /* 32-byte key */
+  FAR const char *nonce;           /* 24-byte nonce */
+  FAR const char *ad;              /* associated data */
+  FAR const char *input;           /* plaintext */
+  FAR const char *result;          /* ciphertext || 16-byte tag */
+  unsigned short adlen;
+  unsigned short ilen;
+  unsigned short rlen;             /* ilen + 16 */
+};
+
+/* chacha20poly1305: key 00..1f, RFC 8439 AAD, the 40-byte RFC 8439
+ * plaintext, at counters 0, 1 and 2. Counter 0 alone cannot catch a wrong
+ * nonce layout (all-zero); counters >= 1 diverge if the counter is placed
+ * in nonce bytes 0..7 instead of 4..11. Reference: pyca/cryptography.
