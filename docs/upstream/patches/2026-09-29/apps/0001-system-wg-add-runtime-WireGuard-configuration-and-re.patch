--- /dev/null
+++ b/system/wg/wg_x25519.c
@@ -0,0 +1,481 @@
+/****************************************************************************
+ * apps/system/wg/wg_x25519.c
+ *
+ * SPDX-License-Identifier: MIT
+ * SPDX-FileCopyrightText: 2015-2016 Cryptography Research, Inc.
+ * SPDX-FileContributor: Mike Hamburg
+ *
+ * Key exchange and signatures based on X25519. Taken from the STROBE
+ * project (https://sourceforge.net/p/strobe), used here for the offline
+ * genkey / pubkey commands so a key pair can be produced before any
+ * WireGuard interface exists.
